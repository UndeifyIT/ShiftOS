{
  "name": "shiftos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @shiftos/web dev",
    "dev:backend": "pnpm --filter @shiftos/backend dev",
    "start:mobile": "pnpm --filter @shiftos/mobile start",
    "build": "pnpm -w exec tsc -b",
    "build:web": "pnpm --filter @shiftos/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "pretest": "pnpm -w exec tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run packages/tests/unit",
    "test:integration": "vitest run packages/tests/integration"
  },
  "devDependencies": {
    "@babel/core": "^7.24.3",
    "@eslint/js": "^9.16.0",
    "@expo/webpack-config": "^19.0.0",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^7.11.1",
    "@typescript-eslint/parser": "^7.11.1",
    "@vitejs/plugin-react": "^4.3.1",
    "babel-preset-expo": "^57.0.5",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.8.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.1",
    "prettier": "^3.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  }
}
