# ShiftOS engineering foundation environment variables
#
# Copy to .env and fill in real values. Never commit .env — only .env.example
# should be tracked, and it must contain placeholders only.

# General application variables
APP_NAME=ShiftOS
APP_ENV=development

# Example API endpoint reference
PUBLIC_API_URL=https://api.example.com

# Example feature flag placeholder
FEATURE_FLAGS=enable-example

# --- Required by @shiftos/config (packages/config/src/index.ts) ---
# Server-side backend configuration. Loaded via loadConfig(); the process
# fails fast at startup if any of the three below are missing.

# Supabase project URL and anon (public) key — safe to expose to clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct Postgres connection string, used by @shiftos/database's pg.Pool adapter.
# Typically the Supabase project's connection pooler string, not the anon key.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

NODE_ENV=development
LOG_LEVEL=info

# --- Server-only secret: NEVER expose to web/mobile client bundles ---
# Required only by packages/auth's SupabaseAuthProvider.createAdminClient()
# (used for admin.inviteUserByEmail). Not read by @shiftos/config's loadConfig()
# on purpose, so it can never end up in a shared config object that a
# client-facing package might import.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
